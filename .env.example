# Copy this file to .env and fill in ONE of the options below. Never commit .env.

# Option A - OpenAI (paid, minimum $5 credit)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Option B - Google Gemini (free tier, no card). Delete Option A's two lines and use these instead:
# OPENAI_API_KEY=your-gemini-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash
